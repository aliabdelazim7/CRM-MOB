VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=PASTE_YOUR_ANON_KEY_HERE

# Email of the admin Supabase Auth account used for the control-panel login.
# Create this account with scripts/provision_auth_users.cjs (see SECURITY_SETUP.md).
VITE_ADMIN_EMAIL=owner@yourstore.com

# ── هوية العميل (كل نشر ليه قيمه الخاصة) ───────────────────────────────────
# دي بتتقري وقت البناء، وبتظهر في عنوان التبويب قبل ما التطبيق يشتغل، وفي
# معاينة الرابط لما يتبعت على واتساب/فيسبوك، وفي اسم تطبيق الـPWA.
# الاسم واللوجو اللي بيتغيّروا من شاشة الإعدادات بيأثّروا جوه التطبيق بس —
# الزواحف (crawlers) بتقرا الـHTML الثابت فمابتشوفهمش.
VITE_APP_NAME=ADRIA
VITE_APP_DESCRIPTION=نظام لإدارة المبيعات والمخزون والكاشير.
VITE_SITE_URL=https://your-app.vercel.app
